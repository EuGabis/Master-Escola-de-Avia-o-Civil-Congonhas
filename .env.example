# Copie este arquivo para .env e preencha os valores.
# NUNCA comite o .env real.

# Banco de dados
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Redis (Upstash, serverless REST)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Seguranca (gerar com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=""
WEBHOOK_SECRET=""

# Evolution API
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE_NAME=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Pusher Channels (realtime)
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# Sentry (opcional - error monitoring)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Para upload de source maps (opcional)
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
